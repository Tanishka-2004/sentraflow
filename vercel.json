{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api/main.py",
      "bindings": [
        {
          "type": "service",
          "service": "serving",
          "format": "url",
          "env": "ML_SERVICE_URL"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "bindings": [
        {
          "type": "service",
          "service": "serving",
          "format": "url",
          "env": "ML_SERVICE_URL"
        }
      ]
    },
    "dashboard": {
      "root": "dashboard",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "API_URL"
        },
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        },
        {
          "type": "service",
          "service": "serving",
          "format": "url",
          "env": "ML_SERVICE_URL"
        }
      ]
    },
    "serving": {
      "root": "ml/serving",
      "framework": "fastapi",
      "entrypoint": "main:app"
    },
    "pipelines": {
      "root": "pipelines",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        },
        {
          "type": "service",
          "service": "serving",
          "format": "url",
          "env": "ML_SERVICE_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": {
        "service": "dashboard"
      }
    },
    {
      "source": "/dashboard/(.*)",
      "destination": {
        "service": "dashboard"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
