# SentraFlow Environment Configuration

ENVIRONMENT=development
AWS_REGION=ap-south-1

# Lakehouse Storage
LAKEHOUSE_BUCKET_PREFIX=sentraflow-lakehouse
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminpassword

# Database & Metadata Store
DATABASE_URL=sqlite:///sentraflow_meta.db
POSTGRES_USER=sentraflow_user
POSTGRES_PASSWORD=sentraflow_password
POSTGRES_DB=sentraflow

# Security & Authentication
JWT_SECRET_KEY=sentraflow-super-secret-jwt-key-32-chars-long!
HMAC_SECRET_KEY=sentraflow-cryptographic-salt-key-for-tokenization-2026!

# Streaming & Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Next.js Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000

